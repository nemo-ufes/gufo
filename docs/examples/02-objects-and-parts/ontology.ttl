@prefix : <https://purl.org/nemo/gufo-examples/objects-and-parts#> .
@prefix gufo: <http://purl.org/nemo/gufo#> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

#################################################################
# gUFO usage example 02: Objects and their parts (Car fleet)
#
# Demonstrates the three ways gUFO subdivides gufo:Object --
# gufo:FunctionalComplex, gufo:Collection (gufo:VariableCollection)
# and gufo:Quantity -- and their respective part-whole properties.
# See index.html for a guided walkthrough.
#################################################################

: a owl:Ontology ;
    rdfs:label "gUFO example 02: Objects and their parts (Car fleet)"@en ;
    rdfs:comment "A small ontology of cars, their components, a fleet, and fuel, illustrating gUFO's classification of complex objects and its part-whole properties."@en ;
    owl:imports <https://purl.org/nemo/gufo#> .

#################################################################
# FunctionalComplex: a car made of components playing different roles
#################################################################

:Car a owl:Class , gufo:Kind ;
    rdfs:subClassOf gufo:FunctionalComplex ;
    rdfs:label "Car"@en ;
    rdfs:comment "A functional complex whose components (engine, wheels, ...) each play a different role in making the whole work."@en .

:Engine a owl:Class , gufo:Kind ;
    rdfs:subClassOf gufo:FunctionalComplex ;
    rdfs:label "Engine"@en .

:Wheel a owl:Class , gufo:Kind ;
    rdfs:subClassOf gufo:FunctionalComplex ;
    rdfs:label "Wheel"@en .

:isEngineOf a owl:ObjectProperty ;
    rdfs:subPropertyOf gufo:isComponentOf ;
    rdfs:domain :Engine ;
    rdfs:range :Car ;
    rdfs:label "is engine of"@en .

:isWheelOf a owl:ObjectProperty ;
    rdfs:subPropertyOf gufo:isComponentOf ;
    rdfs:domain :Wheel ;
    rdfs:range :Car ;
    rdfs:label "is wheel of"@en .

#################################################################
# Collection: a fleet, with members that come and go
#################################################################

:Fleet a owl:Class , gufo:Kind ;
    rdfs:subClassOf gufo:VariableCollection ;
    rdfs:label "Fleet"@en ;
    rdfs:comment "A collection of cars with uniform structure (every member plays the same 'fleet member' role) and variable membership: cars are added when purchased and removed when retired, without the fleet losing its identity."@en .

:isFleetMemberOf a owl:ObjectProperty ;
    rdfs:subPropertyOf gufo:isCollectionMemberOf ;
    rdfs:domain :Car ;
    rdfs:range :Fleet ;
    rdfs:label "is fleet member of"@en .

#################################################################
# Quantity: fuel, whose sub-quantities are portions of *other* stuff
#################################################################

:QuantityOfGasoline a owl:Class , gufo:Kind ;
    rdfs:subClassOf gufo:Quantity ;
    rdfs:label "Quantity of gasoline"@en ;
    rdfs:comment "A maximally self-connected portion of the blended gasoline CityWheels pumps into its cars. 'Maximally self-connected' is the load-bearing part: any two portions of gasoline in contact are one quantity, not two, so a quantity of gasoline never has a smaller quantity of gasoline as a part. Its sub-quantities are portions of the *different* stuffs it is a blend of -- ethanol and petroleum distillate. (Named 'QuantityOfGasoline', not 'Gasoline': instances of this class are individual portions of the stuff, not the material itself.)"@en .

:QuantityOfEthanol a owl:Class , gufo:Kind ;
    rdfs:subClassOf gufo:Quantity ;
    owl:disjointWith :QuantityOfGasoline ;
    rdfs:label "Quantity of ethanol"@en ;
    rdfs:comment "A maximally self-connected portion of ethanol. Disjoint from :QuantityOfGasoline: the two are distinct kinds, obeying distinct principles of identity, and no portion of stuff is an instance of both."@en .

:QuantityOfPetroleumDistillate a owl:Class , gufo:Kind ;
    rdfs:subClassOf gufo:Quantity ;
    owl:disjointWith :QuantityOfGasoline , :QuantityOfEthanol ;
    rdfs:label "Quantity of petroleum distillate"@en ;
    rdfs:comment "A maximally self-connected portion of the petroleum-derived distillate that is blended with ethanol to make the gasoline sold at the pump."@en .

# Both sub-quantity properties are functional: a portion of ethanol is a
# sub-quantity of at most one quantity of gasoline. This is OntoUML's
# non-shareability constraint on subQuantityOf, and it follows from topological
# connection -- a portion of stuff cannot be simultaneously mixed into two
# distinct maximally self-connected wholes.
:isEthanolPortionOf a owl:ObjectProperty , owl:FunctionalProperty ;
    rdfs:subPropertyOf gufo:isSubQuantityOf ;
    rdfs:domain :QuantityOfEthanol ;
    rdfs:range :QuantityOfGasoline ;
    rdfs:label "is ethanol portion of"@en .

:isDistillatePortionOf a owl:ObjectProperty , owl:FunctionalProperty ;
    rdfs:subPropertyOf gufo:isSubQuantityOf ;
    rdfs:domain :QuantityOfPetroleumDistillate ;
    rdfs:range :QuantityOfGasoline ;
    rdfs:label "is distillate portion of"@en .

# Sub-quantities are mandatory (and, beyond what OWL can state, essential)
# parts: every quantity of gasoline is a blend of exactly one portion of
# ethanol and exactly one portion of distillate, and it could not have been
# made of any others without being a different quantity.
:QuantityOfGasoline rdfs:subClassOf
    [ a owl:Restriction ;
        owl:onProperty [ owl:inverseOf :isEthanolPortionOf ] ;
        owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger ;
        owl:onClass :QuantityOfEthanol ] ,
    [ a owl:Restriction ;
        owl:onProperty [ owl:inverseOf :isDistillatePortionOf ] ;
        owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger ;
        owl:onClass :QuantityOfPetroleumDistillate ] .

#################################################################
# Individuals
#################################################################

:Car001 a :Car ;
    rdfs:label "Car 001"@en .

:Car002 a :Car ;
    rdfs:label "Car 002"@en .

:Car001Engine a :Engine ;
    :isEngineOf :Car001 ;
    rdfs:label "Car 001's engine"@en .

:Car001FrontLeftWheel a :Wheel ;
    :isWheelOf :Car001 ;
    rdfs:label "Car 001's front-left wheel"@en .

:Car001FrontRightWheel a :Wheel ;
    :isWheelOf :Car001 ;
    rdfs:label "Car 001's front-right wheel"@en .

:CityWheelsFleet a :Fleet ;
    rdfs:label "CityWheels fleet"@en .

:Car001 :isFleetMemberOf :CityWheelsFleet .
:Car002 :isFleetMemberOf :CityWheelsFleet .

:ElectricSubfleet a :Fleet ;
    gufo:isSubCollectionOf :CityWheelsFleet ;
    rdfs:label "CityWheels electric sub-fleet"@en ;
    rdfs:comment "All members of the electric sub-fleet are, by definition of isSubCollectionOf, also members of the whole fleet."@en .

:Car001 :isFleetMemberOf :ElectricSubfleet .

:Car002FuelTankContents a :QuantityOfGasoline ;
    rdfs:label "Contents of Car 002's fuel tank"@en ;
    rdfs:comment "The gasoline in Car 002's tank: one maximally self-connected portion of stuff, whose sub-quantities are the portions of ethanol and distillate blended into it."@en .

:Car002EthanolPortion a :QuantityOfEthanol ;
    :isEthanolPortionOf :Car002FuelTankContents ;
    rdfs:label "Ethanol portion of Car 002's fuel"@en ;
    rdfs:comment "A legitimate sub-quantity: it is a portion of a different stuff (ethanol, not gasoline), so it is a maximally self-connected quantity in its own right even while blended into the whole."@en .

:Car002DistillatePortion a :QuantityOfPetroleumDistillate ;
    :isDistillatePortionOf :Car002FuelTankContents ;
    rdfs:label "Distillate portion of Car 002's fuel"@en .

#################################################################
# What happens when quantities are mixed or split
#
# A gufo:Quantity has a fixed constitution, so adding or removing stuff never
# gives an existing quantity a new part: it yields a *different* quantity.
# The delivery is therefore modelled as three quantities, not as a parthood
# assertion, and their provenance is recorded with gufo:historicallyDependsOn
# (domain and range gufo:ConcreteIndividual, so it applies to objects as
# readily as to events).
#################################################################

:DepotSupplyBeforeTuesday a :QuantityOfGasoline ;
    rdfs:label "Depot supply before Tuesday's delivery"@en ;
    rdfs:comment "The gasoline sitting in the depot's underground tank up to Tuesday morning."@en .

:TuesdayDeliveryLot a :QuantityOfGasoline ;
    rdfs:label "Tuesday's delivery lot"@en ;
    rdfs:comment "The gasoline that arrived on Tuesday's truck, while still a separate portion in the truck."@en .

:DepotSupplyAfterTuesday a :QuantityOfGasoline ;
    gufo:historicallyDependsOn :DepotSupplyBeforeTuesday , :TuesdayDeliveryLot ;
    rdfs:label "Depot supply after Tuesday's delivery"@en ;
    rdfs:comment "Once the delivery is pumped into the tank, the two portions are in contact and hence one maximally self-connected portion of gasoline -- a new quantity. Neither input is a sub-quantity of it: they are of the same kind as the whole, and after mixing neither is a maximally self-connected portion any more. Nor did :DepotSupplyBeforeTuesday simply grow: sub-quantities are essential parts, so a quantity cannot survive a change of constitution. What links them is history, not parthood."@en .

:Car002FuelTankContents gufo:historicallyDependsOn :DepotSupplyAfterTuesday .
